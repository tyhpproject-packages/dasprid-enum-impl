{
    "name": "tyhpdef/dasprid-enum-impl",
    "description": "Implementation package for tyhpdef/dasprid-enum. Require tyhpdef/dasprid-enum, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.0.7.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/dasprid-enum"
        }
    },
    "require": {
        "php": ">=8.2",
        "dasprid/enum": "^1.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
